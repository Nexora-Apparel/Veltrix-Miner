{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "veltrix-miner",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veltrix-miner",
      "database_id": "REPLACE_AFTER_FREE_D1_DATABASE_CREATION",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "WEB_ORIGIN": ""
  }
}
